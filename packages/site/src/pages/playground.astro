---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { PlaygroundEditor } from "~/components/PlaygroundEditor";
---

<StarlightPage
	frontmatter={{
		title: "Playground",
		template: "splash",
		head: [
			{
				// blocks the sandbox from navigating itself
				attrs: {
					content: "frame-src 'none'",
					"http-equiv": "Content-Security-Policy",
				},
				tag: "meta",
			},
		],
	}}
/>

<div class="editor">
	<PlaygroundEditor client:only="react" />
</div>

<style is:global>
	html,
	body {
		overflow: hidden;
	}
	body {
		display: flex;
		flex-direction: column;
		height: 100svh;
	}
	.page {
		min-height: 0;
	}
	.main-pane {
		display: none;
	}
	.editor {
		position: relative;
		flex-grow: 1;
	}
</style>
